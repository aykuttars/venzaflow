# Python
__pycache__/
__init__.py
!**/migrations/__init__.py
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# Django
backend/staticfiles/
backend/media/
backend/db.sqlite3
backend/.env
backend/local_settings.py

# OpenAPI: regenerable intermediate schema (TS types in frontend are committed)
backend/openapi-schema.yml

# Node / Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/
npm-debug.log*
*.tsbuildinfo

# Electron / eimza
eimza/node_modules/
eimza/dist/
eimza/out/
eimza/release/
eimza/.eslintcache
eimza/.env.local

# Electron / e-barcode (Venzaflow e-barcode masaüstü köprüsü)
ebarcode/node_modules/
ebarcode/dist/
ebarcode/out/
ebarcode/release/
ebarcode/.eslintcache
ebarcode/.env.local

# eimza/build holds electron-builder buildResources (icons, entitlements, hooks);
# re-include it even though the generic `build/` rule above ignores build dirs.
!eimza/build/
!eimza/build/**

# ebarcode/build — macOS entitlements vb. (eimza ile aynı desen)
!ebarcode/build/
!ebarcode/build/**

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker / env
.env
!.env.example
docker/artifacts-registry/cosign/
