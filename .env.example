# Copy to `.env` at repo root for docker-compose / local dev.
# Production targets default to shared 10.0.0.3 infrastructure
# (Postgres + Redis + RabbitMQ).

# --- PostgreSQL ---
POSTGRES_USER=tenancyuser
POSTGRES_PASSWORD=!->ts961ts11ts.*
POSTGRES_DB=tenancysoft
POSTGRES_HOST=10.0.0.3
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
# Celery beat crontab timezone (hourly TCMB fetch at minute 0)
TIME_ZONE=Europe/Istanbul
# Container/image suffix (tenancysoft-api_prod) + Celery queue prefix (prod_default, prod_billing)
ENVIRONMENT=prod
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.0.3,test.aykut.in,test-api.aykut.in
CORS_ALLOWED_ORIGINS=https://test.aykut.in
CSRF_TRUSTED_ORIGINS=https://test.aykut.in,https://test-api.aykut.in

# --- Frontend runtime config (apiBase that the Angular app calls) ---
API_BASE=https://test-api.aykut.in/api/v1

# --- Host ports exposed for Nginx Proxy Manager to target ---
BACKEND_PORT=8001
FRONTEND_PORT=8081

# --- JWT (use a long random secret in prod, separate from SECRET_KEY) ---
JWT_SIGNING_KEY=change-me-jwt-signing-please

# --- Optional seed on container start (dev only) ---
RUN_SEED=false

# --- Redis (optional; not used for Celery results anymore) ---
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=2

# --- RabbitMQ (Celery broker) ---
# When RABBITMQ_HOST is set, URL is built from RABBITMQ_* below.
RABBITMQ_HOST=10.0.0.3
RABBITMQ_PORT=5672
RABBITMQ_USER=aykutt.ars
RABBITMQ_PASS=ayk55577ayk
RABBITMQ_VHOST=/

# Celery results default: django-db (Postgres). Override only if needed:
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Docker --profile local-infra:
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_USER=guest
# RABBITMQ_PASS=guest

# --- NVI / MERNIS ---
NVI_ADDRESS_ENABLED=true
NVI_ADDRESS_MOCK=true
NVI_ADDRESS_BASE_URL=https://adres.nvi.gov.tr
NVI_REQUEST_TIMEOUT=30
NVI_IDENTITY_MOCK=true
# NVI_RECAPTCHA_SITE_KEY=
# NVI_RECAPTCHA_SECRET=
# NVI_RECAPTCHA_RESPONSE=
# NVI_RECAPTCHA_SOLVER_KEY=
# NVI_IDENTITY_WSDL_URL=
# NVI_IDENTITY_USERNAME=
# NVI_IDENTITY_PASSWORD=
