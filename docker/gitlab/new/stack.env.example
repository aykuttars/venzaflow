# Portainer → Stack → Environment variables (her satır KEY=value)
# Secrets: gerçek değerleri Portainer UI'da gir; bu dosyayı git'e commit etme.

GITLAB_HOSTNAME=git.aykut.io
GITLAB_EXTERNAL_URL=https://git.aykut.io
GITLAB_ROOT_PASSWORD=change-me-strong-password
GITLAB_SMTP_ADDRESS=smtp.gmail.com
GITLAB_SMTP_PORT=587
GITLAB_SMTP_USER=aykut.gitlab@gmail.com
GITLAB_SMTP_PASSWORD=your-gmail-app-password
GITLAB_SMTP_DOMAIN=smtp.gmail.com
GITLAB_EMAIL_FROM=git@aykut.io
GITLAB_EMAIL_REPLY_TO=git@aykut.io
